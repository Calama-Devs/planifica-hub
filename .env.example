# Configuração de desenvolvimento local. Não versione credenciais reais.
CI_ENVIRONMENT = development
app_baseURL = 'http://localhost:8080/'

# O CodeIgniter aceita underscores; use os mesmos nomes no .env e no Compose.
database_default_hostname = 127.0.0.1
database_default_database = ''
database_default_username = ''
database_default_password = ''
database_default_DBDriver = MySQLi
database_default_port = 3306

# Somente para o Docker Compose local. Forneça as senhas no .env ou no ambiente.
# Estes valores configuram o MySQL e a conexão da aplicação no container.
DOCKER_BANCO_NOME = planifica_hub
DOCKER_BANCO_USUARIO = planifica
DOCKER_BANCO_SENHA = ''
DOCKER_BANCO_SENHA_ROOT = ''

# Necessário apenas para fluxos de autenticação que enviam e-mail.
# email.fromEmail = ''
# email.fromName = ''
# email.protocol = smtp
# email.SMTPHost = ''
# email.SMTPUser = ''
# email.SMTPPass = ''
# email.SMTPPort = 587
# email.SMTPCrypto = tls

# Configuração de desenvolvimento local. Preencha as credenciais somente no .env.
CI_ENVIRONMENT = development
app.baseURL = 'http://localhost:8080/'

# A forma com underscores também é aceita, sem precisar manter as duas versões.
database.default.hostname = 127.0.0.1
database.default.database = ''
database.default.username = ''
database.default.password = ''
database.default.DBDriver = MySQLi
database.default.port = 3306

# Somente para o Docker Compose local. Preencha as senhas apenas no .env.
# Estes valores configuram o MySQL e a conexão da aplicação no container.
DOCKER_BANCO_NOME = planifica_hub
DOCKER_BANCO_USUARIO = planifica
DOCKER_BANCO_SENHA = 'Preencha com a senha local no .env'
DOCKER_BANCO_SENHA_ROOT = 'Preencha com a senha local no .env'

# Necessário apenas para fluxos de autenticação que enviam e-mail.
# email.fromEmail = ''
# email.fromName = ''
# email.protocol = smtp
# email.SMTPHost = ''
